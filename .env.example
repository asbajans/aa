# App
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://akademi.biz.tr
BETTER_AUTH_SECRET=change_me_32_chars_min
BETTER_AUTH_URL=https://akademi.biz.tr

# Database (HOST:4001 -> CONTAINER:5432, tunnel gerekmez, sadece debug)
DATABASE_URL=postgresql://akademi:change_me@db:5432/akademi
DB_USER=akademi
DB_PASSWORD=change_me
DB_NAME=akademi

# Redis (HOST:4002 -> CONTAINER:6379)
REDIS_URL=redis://redis:6379

# LiveKit (max 10 kişi) — HOST portları 4003-4016 aralığında
LIVEKIT_URL=wss://livekit.akademi.biz.tr
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_EGRESS_WS_URL=ws://livekit:7880

# AI - OpenRouter (GPU yok, fiyat/performans)
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM modelleri (TR için optimize)
AI_MODEL_CHAT=openai/gpt-4o-mini
AI_MODEL_VISION=openai/gpt-4o-mini
AI_MODEL_EMBEDDING=openai/text-embedding-3-small
AI_MODEL_FALLBACK=google/gemini-2.0-flash-001
AI_MODEL_CHEAP=meta-llama/llama-3.1-8b-instruct:free

# TTS - OpenRouter üzerinden + fallback
TTS_PROVIDER=openrouter
TTS_MODEL=openai/gpt-4o-mini-tts
TTS_VOICE=alloy
ELEVENLABS_API_KEY=
CAMBAI_API_KEY=

# STT
STT_PROVIDER=openai
STT_MODEL=whisper-1

# Storage - Cloudflare R2 (S3 uyumlu)
S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=akademi-storage
S3_REGION=auto
S3_PUBLIC_URL=https://cdn.akademi.biz.tr

# Payments - 3 entegrasyon + manuel
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Hakediş
PAYOUT_PERIOD_DAYS=14
PAYOUT_MIN_AMOUNT_TRY=500
PAYOUT_COMMISSION_LIVE=20
PAYOUT_COMMISSION_AI=30
PLATFORM_FEE_PERCENT=10

# Cloudflare Tunnel
TUNNEL_TOKEN=

# Güvenlik
JWT_SECRET=change_me_jwt
ENCRYPTION_KEY=32chars_hex_key_for_voice_data
KVKK_CONSENT_VERSION=v1.0
