{
  "expo": {
    "name": "akademi.biz.tr",
    "slug": "akademi-biz-tr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": { "backgroundColor": "#0a0a0a", "resizeMode": "contain", "image": "./assets/icon.png" },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tr.biz.akademi",
      "infoPlist": {
        "NSCameraUsageDescription": "Soru fotoğrafı çekmek ve canlı derse katılmak için kamera izni gerekli.",
        "NSMicrophoneUsageDescription": "Canlı derste ve AI klonla sesli çalışmak için mikrofon izni gerekli."
      }
    },
    "android": {
      "package": "tr.biz.akademi",
      "permissions": ["CAMERA", "RECORD_AUDIO", "android.permission.CAMERA", "android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": { "favicon": "./assets/favicon.png", "bundler": "metro" },
    "plugins": [
      [
        "expo-camera",
        { "cameraPermission": "Soru fotoğrafı ve canlı ders için kamera izni." }
      ],
      [
        "expo-av",
        { "microphonePermission": "Sesli ders için mikrofon izni." }
      ],
      ["expo-image-picker", { "photosPermission": "Galeri erişimi" }]
    ],
    "extra": {
      "apiUrl": "https://akademi.biz.tr"
    }
  }
}
